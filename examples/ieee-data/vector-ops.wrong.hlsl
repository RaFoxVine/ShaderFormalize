float4 main(float4 input : COLOR0) : SV_Target {
uint4 x = asuint(input); uint4 sum = x;
x.x = x.x + 1u; sum.x = sum.x ^ x.x;
x.y = x.y + 3u; sum.y = sum.y ^ x.y;
x.z = x.z + 5u; sum.z = sum.z ^ x.z;
x.w = x.w + 7u; sum.w = sum.w ^ x.w;
x.x = x.x - 9u; sum.x = sum.x + x.x;
x.y = x.y - 9u; sum.y = sum.y + x.y;
x.z = x.z - 9u; sum.z = sum.z + x.z;
x.w = x.w - 9u; sum.w = sum.w + x.w;
x.x = x.x * 3u; sum.x = sum.x ^ x.x;
x.y = x.y * 3u; sum.y = sum.y ^ x.y;
x.z = x.z * 3u; sum.z = sum.z ^ x.z;
x.w = x.w * 3u; sum.w = sum.w ^ x.w;
x.x = x.x & 0xFFFFFFF0u; sum.x = sum.x + x.x;
x.y = x.y & 0xFFFFFFF0u; sum.y = sum.y + x.y;
x.z = x.z & 0xFFFFFFF0u; sum.z = sum.z + x.z;
x.w = x.w & 0xFFFFFFF0u; sum.w = sum.w + x.w;
x.x = x.x | 5u; sum.x = sum.x ^ x.x;
x.y = x.y | 5u; sum.y = sum.y ^ x.y;
x.z = x.z | 5u; sum.z = sum.z ^ x.z;
x.w = x.w | 5u; sum.w = sum.w ^ x.w;
x.x = x.x ^ 0x12345678u; sum.x = sum.x + x.x;
x.y = x.y ^ 0x12345678u; sum.y = sum.y + x.y;
x.z = x.z ^ 0x12345678u; sum.z = sum.z + x.z;
x.w = x.w ^ 0x12345678u; sum.w = sum.w + x.w;
x.x = x.x << 0u; sum.x = sum.x ^ x.x;
x.y = x.y << 31u; sum.y = sum.y ^ x.y;
x.z = x.z << 32u; sum.z = sum.z ^ x.z;
x.w = x.w << 63u; sum.w = sum.w ^ x.w;
x.x = x.x >> 0u; sum.x = sum.x + x.x;
x.y = x.y >> 31u; sum.y = sum.y + x.y;
x.z = x.z >> 32u; sum.z = sum.z + x.z;
x.w = x.w >> 63u; sum.w = sum.w + x.w;
sum.x = sum.x ^ ~x.x; sum.x = sum.x + -x.x;
sum.y = sum.y ^ ~x.y; sum.y = sum.y + -x.y;
sum.z = sum.z ^ ~x.z; sum.z = sum.z + -x.z;
sum.w = sum.w ^ ~x.w; sum.w = sum.w + -x.w;
return asfloat(uint4(1u,0u,0u,0u) ^ sum);
}
