Shader "ShaderFormalize/Structured/__ROLE__"
{
    Properties
    {
        _BaseColor ("Base Color", Color) = (0.9, 0.24, 0.07, 1)
        _LightColor ("Light Color", Color) = (1, 0.9, 0.8, 1)
        _RimColor ("Rim Color", Color) = (0.1, 0.7, 1, 1)
        _LightDirection ("Direction Toward Light", Vector) = (-0.4, 0.7, -0.6, 0)
        _Ambient ("Ambient", Range(0,1)) = 0.15
        _RimStrength ("Rim Strength", Range(0,4)) = 1.5
        [HideInInspector] _ProbeNormal ("Numeric Probe Normal", Vector) = (0,0,-1,0)
        [HideInInspector] _ProbeView ("Numeric Probe View", Vector) = (0,0,-1,0)
    }
    SubShader
    {
        Tags { "RenderPipeline"="HDRenderPipeline" "RenderType"="HDUnlitShader" "Queue"="Geometry" }
        HLSLINCLUDE
        #include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
        #include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"
        #include "Packages/com.unity.render-pipelines.core/ShaderLibrary/SpaceTransforms.hlsl"
        #include "__ROLE__.hlsl"
        float4 _ProbeNormal;
        float4 _ProbeView;
        struct Attributes { float3 positionOS : POSITION; float3 normalOS : NORMAL; float2 uv : TEXCOORD0; };
        struct Varyings { float4 positionCS : SV_POSITION; float3 normalWS : TEXCOORD0; float3 viewWS : TEXCOORD1; };
        Varyings Vert(Attributes input)
        {
            Varyings output;
            float3 positionWS = TransformObjectToWorld(input.positionOS);
            output.positionCS = TransformWorldToHClip(positionWS);
            output.normalWS = TransformObjectToWorldNormal(input.normalOS);
            output.viewWS = GetWorldSpaceViewDir(positionWS);
            return output;
        }
        float4 EvaluateMaterial(float3 normalWS, float3 viewWS)
        {
            PSInput input;
            input.geometry.normalWS = normalWS;
            input.geometry.viewWS = viewWS;
            return main(input);
        }
        float4 Frag(Varyings input) : SV_Target { return EvaluateMaterial(input.normalWS, input.viewWS); }
        float4 VertNumeric(Attributes input) : SV_POSITION { return float4(input.uv * 2.0 - 1.0, 0.0, 1.0); }
        float4 FragNumeric() : SV_Target { return EvaluateMaterial(_ProbeNormal.xyz, _ProbeView.xyz); }
        ENDHLSL
        Pass
        {
            Name "ForwardOnly"
            Tags { "LightMode"="ForwardOnly" }
            Cull Back ZWrite On ZTest LEqual
            HLSLPROGRAM
            #pragma target 5.0
            #pragma vertex Vert
            #pragma fragment Frag
            ENDHLSL
        }
        Pass
        {
            Name "NumericProbe"
            Tags { "LightMode"="ShaderFormalizeNumeric" }
            Cull Off ZWrite Off ZTest Always
            HLSLPROGRAM
            #pragma target 5.0
            #pragma vertex VertNumeric
            #pragma fragment FragNumeric
            ENDHLSL
        }
    }
}
