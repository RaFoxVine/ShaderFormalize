Shader "ShaderFormalize/Textured/__ROLE__"
{
    Properties
    {
        _BaseMap ("Base Map", 2D) = "white" {}
        _Tint ("Tint", Vector) = (0.9, 0.3, 0.1, 1)
        _UVTransform ("UV Scale / Offset", Vector) = (1, 2, 0.03125, 0.015625)
        _Cutoff ("Alpha Cutoff", Range(0,1)) = 0.5
        _Bottom ("Bottom Cutoff", Range(0,1)) = 0.15
        _Mip ("Detail Mip", Range(0,4)) = 1
        _DetailStrength ("Detail Strength", Range(0,2)) = 0.35
    }
    SubShader
    {
        Tags { "RenderPipeline"="HDRenderPipeline" "RenderType"="HDUnlitShader" "Queue"="AlphaTest" }
        HLSLINCLUDE
        #include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
        #include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"
        #include "Packages/com.unity.render-pipelines.core/ShaderLibrary/SpaceTransforms.hlsl"
        #include "__ROLE__.hlsl"
        struct Attributes { float3 positionOS : POSITION; float2 uv : TEXCOORD0; };
        struct Varyings { float4 positionCS : SV_POSITION; float2 uv : TEXCOORD0; };
        Varyings Vert(Attributes input)
        {
            Varyings output;
            output.positionCS = TransformObjectToHClip(input.positionOS);
            output.uv = input.uv;
            return output;
        }
        Varyings VertNumeric(Attributes input)
        {
            Varyings output;
            output.positionCS = float4(input.uv * 2.0 - 1.0, 0.0, 1.0);
            output.uv = input.uv;
            return output;
        }
        float4 Frag(Varyings input) : SV_Target
        {
            PSInput materialInput;
            materialInput.uv = input.uv;
            return main(materialInput);
        }
        float4 FragUV(Varyings input) : SV_Target { return float4(input.uv, 0.0, 1.0); }
        ENDHLSL
        Pass
        {
            Name "ForwardOnly"
            Tags { "LightMode"="ForwardOnly" }
            Cull Back ZWrite On ZTest LEqual
            HLSLPROGRAM
            #pragma target 5.0
            #pragma vertex Vert
            #pragma fragment Frag
            ENDHLSL
        }
        Pass
        {
            Name "NumericProbe"
            Tags { "LightMode"="ShaderFormalizeNumeric" }
            Cull Off ZWrite Off ZTest Always
            HLSLPROGRAM
            #pragma target 5.0
            #pragma vertex VertNumeric
            #pragma fragment Frag
            ENDHLSL
        }
        Pass
        {
            Name "UVCalibration"
            Tags { "LightMode"="ShaderFormalizeCalibration" }
            Cull Off ZWrite Off ZTest Always
            HLSLPROGRAM
            #pragma target 5.0
            #pragma vertex VertNumeric
            #pragma fragment FragUV
            ENDHLSL
        }
    }
}
